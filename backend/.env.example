# ---------- App ----------
APP_NAME=TransitTechOS Orchestrator
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=change-me-in-real-deployments
JWT_EXPIRE_MINUTES=720
# Real products push events to POST /api/events/ingest with header X-Ingest-Key
INGEST_API_KEY=local-ingest-key

# ---------- Sign-in ----------
# local = demo accounts (JWT) | gcip = Google Cloud Identity Platform
AUTH_MODE=local
GCIP_PROJECT_ID=
GCIP_API_KEY=
# multi-tenant Identity Platform: <gcip tenant id>:<agency id>,...  e.g. mvt-x1y2:ten_mvt,lsp-a3b4:ten_lsp
GCIP_TENANT_MAP=
GCIP_AUTO_PROVISION=false

# ---------- Storage ----------
# PostgreSQL (default). The database is created on first start if DB_AUTO_CREATE=true.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transit_orchestrator
DB_AUTO_CREATE=true
# SQLite fallback (no server):
# DATABASE_URL=sqlite+aiosqlite:///./data/transit.db
# Tests use DATABASE_URL with the database renamed to transit_orchestrator_test, unless this is set:
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transit_orchestrator_test
CHECKPOINT_DB_PATH=./data/checkpoints.db
SEED_ON_STARTUP=true
SEED_RANDOM_SEED=42
SEED_WITH_HISTORY=true

# ---------- Event backbone ----------
# inmemory = local bus persisted to the database | eventbridge = Amazon EventBridge | msk = Amazon MSK / Kafka
EVENT_BUS=inmemory
EVENTBRIDGE_BUS_NAME=transittech-orchestration
# EventBridge rule -> SQS queue the orchestrator consumes (inbound events from other producers)
EVENTBRIDGE_SQS_QUEUE_URL=
AWS_REGION=us-east-1
MSK_BOOTSTRAP_SERVERS=
MSK_TOPIC=transittech.events
MSK_CONSUMER_GROUP=transit-orchestrator
# PLAINTEXT | SSL | SASL_SSL ; mechanism SCRAM-SHA-512 | AWS_MSK_IAM | PLAIN
MSK_SECURITY_PROTOCOL=PLAINTEXT
MSK_SASL_MECHANISM=
MSK_USERNAME=
MSK_PASSWORD=
# Late / out-of-order events: dispatch bursts in event-time order; ignore trigger events older than this
EVENT_REORDER_WINDOW_MS=300
EVENT_MAX_AGE_HOURS=24

# ---------- LLM ----------
# mock = deterministic, no key needed | anthropic | bedrock | ollama
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
BEDROCK_MODEL_FAST=
BEDROCK_MODEL_SMART=
LLM_DAILY_TOKEN_BUDGET=200000

# ---------- Operator Performance SLM ----------
# mock = grounded template answers | ollama = real local small model (install Ollama, run: ollama pull llama3.2:3b)
SLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ---------- Product adapters ----------
# mock = synthetic in-process products | http = call real product APIs below
ADAPTER_MODE=mock
ASSET_API_BASE_URL=https://faster.example.com/api
ASSET_API_KEY=
TRIP_API_BASE_URL=https://ecolane.example.com/api
TRIP_API_KEY=
WORKFORCE_API_BASE_URL=https://bytecurve.example.com/api
WORKFORCE_API_KEY=
RIDER_COMMS_API_BASE_URL=https://tripshot.example.com/api
RIDER_COMMS_API_KEY=
SAFETY_API_BASE_URL=https://vestige.example.com/api
SAFETY_API_KEY=
ADAPTER_MAX_RETRIES=3
ADAPTER_RATE_LIMIT_PER_SECOND=20

# ---------- Audit sink ----------
# sqlite (always on) + optional mirror: none | jsonl | databricks
AUDIT_MIRROR=jsonl
AUDIT_JSONL_PATH=./data/audit_delta_export.jsonl
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
DATABRICKS_AUDIT_TABLE=orchestration.audit.decision_log
# Audit outbox shipping to the mirror (with retries)
AUDIT_SHIP_INTERVAL_SECONDS=2
AUDIT_SHIP_BATCH_SIZE=200

# ---------- Background simulators ----------
TELEMETRY_STREAM_ENABLED=false
TELEMETRY_INTERVAL_SECONDS=15
PM_SCAN_INTERVAL_SECONDS=300

# ---------- Observability ----------
OTEL_ENABLED=false
# OTLP/HTTP collector (Jaeger, Grafana Tempo, AWS ADOT); empty = print spans to the console
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=transit-orchestrator
LOG_LEVEL=INFO
